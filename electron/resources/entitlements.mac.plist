<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- JIT and unsigned-memory: required by Python/numpy/CFFI/PyTorch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- llama-index loads .so plugins outside the app's signing chain. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Electron passes env vars to child sidecars. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Sidecars listen on 127.0.0.1 (server) and reach LLM APIs (client). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- File picker (Open PDF...) and drag-drop. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
